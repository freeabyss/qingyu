    "permission.adhocSignature.note" : {
      "comment" : "Note shown when the app is ad-hoc signed: the screen recording grant is keyed by code hash",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note: this is a development build with an ad-hoc signature. macOS records this permission per code hash, so it stops matching every time the app is rebuilt. If System Settings already lists Qingyu, remove that entry first, then grant it again for this build."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说明：当前是 ad-hoc 签名的开发构建。macOS 按代码哈希记录该权限，因此每次重新编译后旧授权都会失效。若系统设置里已有旧的「清羽」条目，请先移除它，再为本构建重新授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說明：目前是 ad-hoc 簽章的開發版本。macOS 會依程式碼雜湊記錄此權限，因此每次重新建置後舊授權就會失效。若系統設定中已有舊的「清羽」項目，請先將它移除，再為此版本重新授權。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注記：これは ad-hoc 署名の開発ビルドです。macOS はこの権限をコードハッシュ単位で記録するため、再ビルドのたびに一致しなくなります。システム設定に「Qingyu」の項目がすでにある場合は、まずそれを削除してから、このビルドに対して改めて許可してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : il s'agit d'une version de développement avec une signature ad hoc. macOS enregistre cette autorisation par hachage de code, elle ne correspond donc plus à chaque recompilation de l'app. Si Réglages Système liste déjà Qingyu, supprimez d'abord cette entrée, puis accordez-la à nouveau pour cette version."
          }
        }
      }
    },
    "screenshot.permission.cancel" : {
      "comment" : "Cancel button for screen recording permission alert",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {

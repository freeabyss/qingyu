    "about.feedback.sheet.scope" : {
      "comment" : "Feedback scope text",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before opening your mail app, review what will be included. You can cancel now. No clipboard history, screenshots, files, or automatic crash logs are attached."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开邮件应用前，请先查看将包含的信息范围。你现在可以取消。不会附带剪贴板历史、截图、文件或自动崩溃日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開郵件 App 前，請先查看將包含的資訊範圍。你現在可以取消。不會附帶剪貼簿歷史、截圖、檔案或自動當機日誌。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアプリを開く前に、含まれる情報の範囲を確認してください。ここでキャンセルできます。クリップボードの履歴、スクリーンショット、ファイル、自動クラッシュログは添付されません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant d'ouvrir votre app de messagerie, vérifiez ce qui sera inclus. Vous pouvez annuler maintenant. Aucun historique du presse-papiers, aucune capture d'écran, aucun fichier ni journal d'erreur automatique n'est joint."
          }
        }
      }
    },

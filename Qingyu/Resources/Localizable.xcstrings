      }
    },
    "privacy.local.body" : {
      "comment" : "Privacy local first body",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清羽 Qingyu does not upload, sync, or use your clipboard history, screenshots, settings, usage records, or feedback text to train models. No account is required."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清羽 Qingyu 不会上传、同步剪贴板历史、截图、设置、使用记录或反馈文本，也不会用这些数据训练模型。无需账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清羽 Qingyu 不會上傳、同步你的剪貼簿歷史、截圖、設定、使用記錄或意見回饋文字，也不會將這些資料用於訓練模型。不需要帳號。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清羽 Qingyu は、クリップボードの履歴、スクリーンショット、設定、使用記録、フィードバックのテキストをアップロード、同期したり、モデルのトレーニングに使用したりしません。アカウントは必要ありません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清羽 Qingyu ne téléverse, ne synchronise ni n'utilise votre historique du presse-papiers, vos captures d'écran, vos réglages, vos enregistrements d'utilisation ou le texte de vos commentaires pour entraîner des modèles. Aucun compte n'est requis."
          }
        }
      }
    },
    "privacy.local.title" : {
      "comment" : "Privacy local first title",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local-first data handling"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地优先的数据处理"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機優先的資料處理"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル優先のデータ処理"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traitement des données en local d'abord"
          }
        }
      }
    },
    "privacy.screenshot.body" : {
      "comment" : "Privacy screenshot body",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots are captured and processed locally. Saving writes PNG files to your configured screenshots folder. Copying writes the image to the system clipboard and follows the same local clipboard-history behavior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图仅在本机捕获和处理。保存会将 PNG 写入你配置的截图目录。复制会写入系统剪贴板，并遵循同样的本地剪贴板历史行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截圖僅在本機擷取與處理。儲存會將 PNG 檔案寫入你設定的截圖檔案夾。拷貝會將影像寫入系統剪貼簿，並遵循相同的本機剪貼簿歷史行為。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットはこの Mac 内で撮影・処理されます。保存すると、設定したスクリーンショットフォルダに PNG ファイルが書き出されます。コピーすると、イメージがシステムのクリップボードに書き込まれ、クリップボードの履歴と同じローカルでの動作に従います。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures d'écran sont prises et traitées localement. L'enregistrement écrit des fichiers PNG dans votre dossier de captures d'écran configuré. La copie écrit l'image dans le presse-papiers système et suit le même comportement local d'historique du presse-papiers."
          }
        }
      }
    },

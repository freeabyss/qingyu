    "onboarding.screenRecording.description" : {
      "comment" : "",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS requires Screen Recording permission before Assistant can capture screenshots. Without it, screenshot features cannot work."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 要求授予屏幕录制权限后，Assistant 才能进行截图。未授权时截图功能无法使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 要求先授予螢幕錄製權限，Assistant 才能截圖。未授權時無法使用截圖功能。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS では、Assistant がスクリーンショットを撮るために画面収録権限が必要です。許可しないとスクリーンショット機能は使用できません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS exige l'autorisation Enregistrement de l'écran avant qu'Assistant puisse réaliser des captures d'écran. Sans elle, les fonctions de capture ne peuvent pas fonctionner."
          }
        }
      }
    },
    "onboarding.screenRecording.explain" : {
      "comment" : "Onboarding screen recording explanation",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Recording permission is used for region, fullscreen, and window screenshots. All screenshots are processed locally."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕录制权限用于区域/全屏/窗口截图,所有截图均在本地处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕錄製權限用於區域、全螢幕與視窗截圖，所有截圖均在本機處理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録権限は、範囲選択、全画面、ウインドウのスクリーンショットに使用します。スクリーンショットはすべてローカルで処理されます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'autorisation Enregistrement de l'écran sert aux captures de zone, plein écran et fenêtre. Toutes les captures d'écran sont traitées localement."
          }
        }
      }
    },

      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a recorder field and press your desired key combination. Capture Region lets you select an area to screenshot. Capture Window captures the window under your cursor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击录制区域并按下你想要的组合键。区域截图可让你选择截图区域，窗口截图可捕捉光标下的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按錄製欄位並按下你想要的按鍵組合。區域截圖可讓你選擇要截圖的範圍，視窗截圖會擷取游標下的視窗。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録フィールドをクリックし、任意のキーの組み合わせを押します。範囲選択ではスクリーンショットを撮る範囲を指定できます。ウインドウを撮影ではカーソル下のウインドウをキャプチャします。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un champ d'enregistrement et appuyez sur la combinaison de touches souhaitée. Capturer une zone vous permet de sélectionner une zone à capturer. Capturer une fenêtre capture la fenêtre sous votre curseur."
          }
        }

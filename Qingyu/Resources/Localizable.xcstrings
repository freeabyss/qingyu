    "settings.elementDetection.note" : {
      "comment" : "Element detection setting: permission note",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requires Accessibility permission. Without it, detection silently falls back to windows only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「辅助功能」权限；未授权时自动降级为只识别窗口，不会打断截图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「輔助使用」權限；未授權時會自動降級為僅辨識視窗，不會中斷截圖。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アクセシビリティ」権限が必要です。許可されていない場合は、ウインドウのみの検出に自動的に切り替わり、スクリーンショットを中断しません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite l'autorisation Accessibilité. Sans elle, la détection se limite silencieusement aux fenêtres."
          }
        }
      }
    },

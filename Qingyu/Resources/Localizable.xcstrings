    "settings.pin.snapThreshold.note" : {
      "comment" : "Note: pin snapping",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag a pin near a window or screen edge to align; hold ⌘ to disable temporarily. 0 turns snapping off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动贴图靠近窗口或屏幕边缘时自动对齐；按住 ⌘ 可临时禁用。0 表示关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳貼圖靠近視窗或螢幕邊緣時會自動對齊；按住 ⌘ 可暫時停用。0 表示關閉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンをウインドウや画面の端に近づけると整列します。⌘ を押している間は一時的に無効になります。0 で吸着をオフにします。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une épingle près d'une fenêtre ou du bord de l'écran pour l'aligner ; maintenez ⌘ pour désactiver temporairement. 0 désactive l'alignement."
          }
        }
      }
    },
    "settings.pin.shortcuts.section" : {
      "comment" : "Section: pin interaction shortcuts",
      "extractionState" : "manual",
      "localizations" : {

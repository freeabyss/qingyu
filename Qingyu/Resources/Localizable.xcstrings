    "settings.pin.shortcuts.note" : {
      "comment" : "Note: pin shortcuts scope",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin shortcuts act on the pin under the cursor. With no pin under the cursor, the click-through shortcut toggles every pin and the scale/opacity shortcuts do nothing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴图快捷键作用于「光标下的贴图」；光标下没有贴图时，穿透键作用于全部贴图，缩放与不透明度键不响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼圖快速鍵作用於「游標下的貼圖」；游標下沒有貼圖時，穿透鍵會作用於所有貼圖，縮放與不透明度鍵則沒有反應。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンのキーボードショートカットは「カーソル下のピン」に作用します。カーソル下にピンがない場合、クリック透過のショートカットはすべてのピンに作用し、拡大縮小と不透明度のショートカットは反応しません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis d'épinglage agissent sur l'épingle sous le curseur. Sans épingle sous le curseur, le raccourci de clic traversant bascule toutes les épingles et les raccourcis d'échelle et d'opacité n'ont aucun effet."
          }
        }
      }
    },

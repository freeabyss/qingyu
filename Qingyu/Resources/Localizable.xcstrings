    "settings.quickLaunch.keyword.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type a keyword, a space, then your text, and press Return to open the matching site with that text. Clearing the “Enabled” checkbox retires an entry but keeps its keyword."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入「关键词 + 空格 + 文字」后回车，打开对应网页并把文字带过去。取消勾选「启用」即停用该条目，关键词会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入「關鍵字 + 空格 + 文字」後按 Return，即可開啟對應網站並帶入文字。取消勾選「啟用」會停用該項目，但關鍵字會保留。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「キーワード + スペース + テキスト」を入力して Return キーを押すと、対応するサイトをそのテキスト付きで開きます。「有効」のチェックを外すとその項目は無効になりますが、キーワードは保持されます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un mot-clé, un espace, puis votre texte, et appuyez sur Retour pour ouvrir le site correspondant avec ce texte. Décocher la case « Activé » désactive une entrée mais conserve son mot-clé."
          }
        }
      }
    },

    "data.migration.failed.message" : {
      "comment" : "Body of the migration fallback alert. %@ is the backup directory path.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't move your existing data to the new location, so a copy was saved to:\n%@\n\nQingyu started with a fresh library. Your old data is safe in the backup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将现有数据移动到新位置,已复制备份到:\n%@\n\n清羽已使用新的空数据库启动,你的旧数据已安全保存在备份目录中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將現有資料移到新位置，已複製一份備份到：\n%@\n\n清羽已改用全新的資料庫啟動，你的舊資料已安全保存在備份中。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のデータを新しい場所に移動できませんでした。コピーを以下に保存しました：\n%@\n\nQingyu は新しいライブラリで起動しました。以前のデータはバックアップ内に安全に保存されています。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'avons pas pu déplacer vos données existantes vers le nouvel emplacement ; une copie a donc été enregistrée dans :\n%@\n\nQingyu a démarré avec une bibliothèque vide. Vos anciennes données sont en sécurité dans la sauvegarde."
          }
        }
      }
    },

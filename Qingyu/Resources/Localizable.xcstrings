    "settings.presets.empty" : {
      "comment" : "Empty state for the preset list",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No presets yet. In a capture session, drag a region and press ⌘S to save it as a preset (⌘⇧S for a fixed size)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有预设。在截图会话中框选区域后按 ⌘S 存为区域预设（⌘⇧S 存为固定尺寸）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有預設。在截圖工作階段中拖曳選取區域後，按 ⌘S 可儲存為區域預設（⌘⇧S 儲存為固定尺寸）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットはまだありません。撮影セッションで範囲を選択して ⌘S を押すと保存できます（⌘⇧S で固定サイズ）。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun préréglage pour l'instant. Dans une session de capture, faites glisser une zone puis appuyez sur ⌘S pour l'enregistrer comme préréglage (⌘⇧S pour une taille fixe)."
          }
        }
      }
    },
    "settings.presets.note" : {
      "comment" : "Note under the preset list",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Region presets remember their display and position; size presets are centered on the pointer when applied. Presets are user data and travel with your data folder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区域预设会记住所在屏幕与位置；尺寸预设套用时以指针为中心。预设属于用户数据，随数据目录一起备份迁移。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "區域預設會記住所在的螢幕與位置；尺寸預設套用時以指標為中心。預設屬於使用者資料，會隨資料檔案夾一起備份與移轉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲プリセットはディスプレイと位置を記憶し、サイズプリセットは適用時にポインタを中心にします。プリセットはユーザーデータに含まれ、データフォルダーと一緒にバックアップ・移行されます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages de zone mémorisent leur écran et leur position ; les préréglages de taille sont centrés sur le pointeur lors de leur application. Les préréglages sont des données utilisateur et suivent votre dossier de données."
          }
        }
      }
    },

          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôles utilisateur"
          }
        }
      }
    },
    "privacy.feedback.body" : {
      "comment" : "Privacy feedback body",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback is sent only when you click the feedback button, review the data scope, and choose to open your mail app. The prefilled email includes app version, build number, macOS version, an error summary, and your notes. It does not attach clipboard history, screenshots, files, or automatic crash logs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈仅在你点击反馈按钮、查看数据范围并选择打开邮件应用后发送。预填邮件包含应用版本、构建号、macOS 版本、错误摘要和你的补充说明，不附带剪贴板历史、截图、文件或自动崩溃日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你點按意見回饋按鈕、檢視資料範圍並選擇開啟郵件 App 後，才會傳送意見回饋。預先填寫的郵件包含 App 版本、建置版本號、macOS 版本、錯誤摘要與你的補充說明，不會附加剪貼簿歷史、截圖、檔案或自動崩潰記錄。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックは、あなたがフィードバックボタンをクリックし、データの範囲を確認してメールアプリを開くことを選んだ場合にのみ送信されます。下書きメールにはアプリのバージョン、ビルド番号、macOS のバージョン、エラーの概要、あなたの補足が含まれます。クリップボードの履歴、スクリーンショット、ファイル、自動クラッシュログは添付されません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commentaires ne sont envoyés que lorsque vous cliquez sur le bouton de commentaires, vérifiez la portée des données et choisissez d'ouvrir votre app de messagerie. L'e-mail prérempli contient la version de l'app, le numéro de build, la version de macOS, un résumé de l'erreur et vos notes. Il ne joint ni l'historique du presse-papiers, ni les captures d'écran, ni les fichiers, ni les journaux de plantage automatiques."
          }
        }
      }
    },
    "privacy.feedback.title" : {
      "comment" : "Privacy feedback title",
      "extractionState" : "stale",
      "localizations" : {

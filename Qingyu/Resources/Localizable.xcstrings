    "privacy.clipboard.body" : {
      "comment" : "Privacy clipboard body",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipboard history is stored locally in Application Support. Text metadata is stored in the local database; image and rich-text resources are stored as local files. File clipboard entries save references and paths only, not file contents. You can pause recording in Settings and clear history from the Clipboard History page."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴板历史保存在本机 Application Support 中。文本元数据保存在本地数据库；图片和富文本资源保存在本地文件。文件剪贴板项只保存引用和路径，不复制文件内容。你可以在设置中暂停记录，并在剪贴板历史页清空历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪貼簿歷史儲存在本機的 Application Support 中。文字中介資料儲存在本機資料庫；圖片與富文字資源以本機檔案形式儲存。檔案剪貼簿項目只儲存參照與路徑，不會複製檔案內容。你可以在設定中暫停記錄，並在剪貼簿歷史頁面清除歷史。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードの履歴はこの Mac の Application Support に保存されます。テキストのメタデータはローカルデータベースに保存され、イメージとリッチテキストのリソースはローカルファイルとして保存されます。ファイルのクリップボード項目は参照とパスのみを保存し、ファイルの内容はコピーしません。設定で記録を一時停止でき、クリップボードの履歴ページから履歴を消去できます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'historique du presse-papiers est stocké localement dans Application Support. Les métadonnées de texte sont stockées dans la base de données locale ; les ressources d'images et de texte enrichi sont stockées sous forme de fichiers locaux. Les entrées de fichiers du presse-papiers n'enregistrent que des références et des chemins, pas le contenu des fichiers. Vous pouvez mettre en pause l'enregistrement dans les Réglages et effacer l'historique depuis la page Historique du presse-papiers."
          }
        }
      }
    },
    "privacy.clipboard.title" : {

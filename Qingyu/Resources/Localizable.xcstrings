    "permission.onDemand.accessibility.message" : {
      "comment" : "On-demand accessibility alert message",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This feature needs Accessibility permission for controlled automation such as auto-paste or simulated shortcuts. Open System Settings to grant it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能需要辅助功能权限,用于受控自动化(如自动粘贴、模拟快捷键)。打开系统设置以授予。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能需要「輔助使用」權限，用於受控自動化（如自動貼上、模擬快速鍵）。請開啟系統設定以授予。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この機能は、自動ペーストやキーボードショートカットのシミュレートなどの制御された自動化のためにアクセシビリティ権限を必要とします。システム設定を開いて許可してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fonctionnalité a besoin de l'autorisation Accessibilité pour une automatisation contrôlée, comme le collage automatique ou la simulation de raccourcis. Ouvrez Réglages Système pour l'accorder."
          }
        }
      }
    },

    "privacy.control.body" : {
      "comment" : "Privacy user control body",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can disable clipboard recording, change the retention period, delete individual history items, or clear all clipboard history. Clearing history requires confirmation and is not automatically uploaded or reported."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以关闭剪贴板记录、调整保留时间、删除单条历史或清空全部剪贴板历史。清空历史需要确认，且不会被自动上传或上报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以關閉剪貼簿記錄、調整保留時間、刪除單筆歷史或清除所有剪貼簿歷史。清除歷史需要確認，且不會自動上傳或回報。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードの記録をオフにする、保存期間を変更する、履歴を個別に削除する、クリップボードの履歴をすべて消去する、といった操作ができます。履歴の消去には確認が必要で、自動的にアップロードや送信が行われることはありません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez désactiver l'enregistrement du presse-papiers, modifier la durée de conservation, supprimer des entrées individuelles ou effacer tout l'historique du presse-papiers. L'effacement de l'historique nécessite une confirmation et n'est ni téléversé ni signalé automatiquement."
          }
        }
      }
    },
    "privacy.control.title" : {
      "comment" : "Privacy user control title",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "User controls"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户控制"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

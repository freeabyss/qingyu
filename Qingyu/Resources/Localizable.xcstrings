    "onboarding.accessibility.boundary" : {
      "comment" : "",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MVP uses this permission only within documented Assistant features. It does not run arbitrary shell commands or upload your data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MVP 仅在已说明的 Assistant 功能边界内使用此权限，不执行任意 shell，也不会上传你的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MVP 僅在已說明的 Assistant 功能範圍內使用此權限，不會執行任意 shell，也不會上傳你的資料。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MVP では、この権限をドキュメントに記載された Assistant の機能の範囲内でのみ使用します。任意のシェルコマンドを実行したり、データをアップロードしたりすることはありません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version MVP utilise cette autorisation uniquement dans le cadre des fonctionnalités Assistant documentées. Elle n'exécute aucune commande shell arbitraire et ne téléverse pas vos données."
          }
        }
      }
    },
    "onboarding.accessibility.description" : {
      "comment" : "",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant needs Accessibility permission for controlled macOS automation paths such as future auto-paste, window control, simulated shortcuts, and controlling other apps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant 需要辅助功能权限，用于受控的 macOS 自动化路径，例如后续自动粘贴、窗口控制、模拟快捷键和控制其他 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant 需要「輔助使用」權限，用於受控的 macOS 自動化路徑，例如日後的自動貼上、視窗控制、模擬快速鍵與控制其他 App。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant は、今後の自動ペースト、ウインドウ操作、キーボードショートカットのシミュレート、他のアプリの操作など、制御された macOS の自動化のためにアクセシビリティ権限を必要とします。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant a besoin de l'autorisation Accessibilité pour les procédés d'automatisation macOS contrôlés, comme le collage automatique à venir, le contrôle des fenêtres, la simulation de raccourcis et le contrôle d'autres apps."
          }
        }
      }
    },
    "onboarding.accessibility.explain" : {
      "comment" : "Onboarding accessibility explanation",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility permission is used for future quick actions (such as auto-paste and simulated shortcuts). You can grant it when you need it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能权限用于未来的快捷操作(如自动粘贴、模拟快捷键)。你可以在用到时再授予。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

    "feedback.email.privacyNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy note: this email is sent only after you confirm it in your mail app. Qingyu does not attach clipboard history, screenshots, files, or automatic crash logs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐私说明：这封邮件只会在你于邮件客户端确认后发出。清羽不会附带剪贴板历史、截图、文件或自动崩溃日志。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱私權說明：這封郵件只會在你於郵件 App 中確認後送出。清羽不會附加剪貼簿歷史、截圖、檔案或自動崩潰記錄。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーについて：このメールは、メールアプリで確認したあとにのみ送信されます。Qingyu はクリップボードの履歴、スクリーンショット、ファイル、自動クラッシュログを添付しません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note de confidentialité : cet e-mail n'est envoyé qu'après votre confirmation dans votre app de messagerie. Qingyu ne joint ni l'historique du presse-papiers, ni les captures d'écran, ni les fichiers, ni les journaux de plantage automatiques."
          }
        }
      }

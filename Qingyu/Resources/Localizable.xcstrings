    "onboarding.launchAtLogin.description" : {
      "comment" : "",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant is designed as a menu bar utility. Launch at login is enabled by default after Onboarding and can be turned off later in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant 是菜单栏效率工具。完成首次引导后默认启用开机启动，你也可以之后在设置中关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant 是選單列工具。完成首次導覽後會預設啟用開機時啟動，你也可以之後在設定中關閉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant はメニューバーのユーティリティとして設計されています。初回ガイドの完了後、ログイン時に起動がデフォルトで有効になり、あとで設定からオフにできます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant est conçu comme un utilitaire de barre des menus. L'ouverture à l'ouverture de session est activée par défaut après l'accueil et peut être désactivée plus tard dans les Réglages."
          }
        }
      }
    },

    "about.release.feedback" : {
      "comment" : "About feedback commitment",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback is user-initiated email only. The app shows the data scope first and never sends diagnostics silently."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈仅由用户主动通过邮件触发。应用会先展示数据范围，绝不静默发送诊断信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回饋僅由使用者主動透過郵件觸發。App 會先顯示資料範圍，絕不會默默傳送診斷資訊。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックはユーザーがメールで能動的に送信する場合のみです。アプリは先にデータの範囲を表示し、診断情報を無断で送信することはありません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le retour se fait uniquement par e-mail, à votre initiative. L'app affiche d'abord l'étendue des données et n'envoie jamais de diagnostics en silence."
          }
        }
      }
    },
    "about.release.privacy" : {

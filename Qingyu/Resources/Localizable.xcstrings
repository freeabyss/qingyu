    "settings.hotCorners.note" : {
      "comment" : "Note under the hot corner switch",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push the pointer into a corner and hold it there to trigger. Default off — hot corners are easy to hit by accident."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把指针推入角落并停留片刻即触发。默认关闭 —— 热区很容易误触。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標移到角落並停留片刻即可觸發。預設為關閉 —— 熱區很容易誤觸。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタを隅に押し込んでしばらく止めると実行されます。デフォルトはオフです。ホットコーナーは誤って触れやすいためです。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez le pointeur dans un coin et maintenez-le pour déclencher. Désactivé par défaut — les coins actifs se déclenchent facilement par accident."
          }
        }
      }
    },

    "screenshot.permission.message" : {
      "comment" : "Alert message: screen recording permission required, including the relaunch step",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qingyu needs Screen Recording permission to take screenshots. Grant it in System Settings. macOS caches this decision for the running app, so use Relaunch Qingyu afterwards to make the grant take effect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清羽需要屏幕录制权限才能截图。请在系统设置中授权。macOS 会缓存当前运行实例的授权判定，授权后请点「重新启动清羽」让授权生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清羽需要螢幕錄製權限才能截圖。請在系統設定中授予。macOS 會快取目前執行中 App 的授權判定，授權後請點按「重新啟動清羽」讓授權生效。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qingyu がスクリーンショットを撮るには画面収録権限が必要です。システム設定で許可してください。macOS は実行中のアプリに対する判定をキャッシュするため、許可したあとに「Qingyu を再起動」を実行して反映させてください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qingyu a besoin de l'autorisation Enregistrement de l'écran pour réaliser des captures d'écran. Accordez-la dans Réglages Système. macOS met en cache cette décision pour l'app en cours d'exécution, utilisez donc « Relancer Qingyu » ensuite pour que l'autorisation prenne effet."
          }
        }
      }
    },
